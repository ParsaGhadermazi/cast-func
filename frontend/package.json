{
  "name": "cast-editor",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "Browser editor for cast. Builds into ../cast/static/editor/.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && npm run build:viewer",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "build:viewer": "rm -rf ../cast/static/viewer && vite build -c vite.viewer.config.ts && VIEWER_PLOTLY=global vite build -c vite.viewer.config.ts",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "immer": "11.1.18",
    "lucide-react": "1.47.0",
    "marked": "18.0.13",
    "plotly.js-dist-min": "3.7.0",
    "react": "19.1.9",
    "react-dom": "19.1.9",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "22.18.0",
    "@types/plotly.js-dist-min": "2.3.4",
    "@types/react": "19.1.9",
    "@types/react-dom": "19.1.9",
    "@vitejs/plugin-react": "4.7.0",
    "jsdom": "26.1.0",
    "typescript": "6.0.3",
    "vite": "6.4.4",
    "vitest": "4.1.11"
  },
  "engines": {
    "node": ">=20"
  }
}
